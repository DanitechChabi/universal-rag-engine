# Modèle du fichier .env de production : généré par scripts/install-server.sh, droits 600.
# Aucune valeur réelle ici.
URAG_DATA_DIR=/var/lib/urag
URAG_DOCUMENTS_DIR=/srv/documents
URAG_SITE_ADDRESS=rag.exemple.local
URAG_TLS=internal
URAG_HTTPS_PORT=443
# 127.0.0.1 derrière un relais HTTPS existant (install-server.sh --behind-proxy)
URAG_BIND_ADDRESS=0.0.0.0
URAG_API_WORKERS=2  # (mémoire visible en Go − 9) / 3, entre 1 et 4 ; choisi par install-server.sh
URAG_PG_SUPERUSER_PASSWORD=CHANGER
URAG_APP_DB_PASSWORD=CHANGER
URAG_QDRANT_API_KEY=CHANGER
