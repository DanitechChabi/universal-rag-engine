# Universal RAG Engine — modèle de configuration (copier en .env, ne jamais committer .env)
# Aucune valeur sensible ici : les mots de passe et clés sont générés à l'installation.

URAG_MODE=server                      # server | desktop
URAG_ENV=development                  # development | test | production

# PostgreSQL (rôle applicatif urag_app, soumis à la RLS)
URAG_DATABASE_URL=postgresql://urag_app:CHANGER@postgres:5432/urag

# Qdrant
URAG_QDRANT_URL=http://qdrant:6333
URAG_QDRANT_API_KEY=CHANGER

# Clé maîtresse des secrets : chemin d'un fichier hors du dépôt (32 octets aléatoires)
URAG_MASTER_KEY_FILE=/etc/urag/master.key

# Génération locale
URAG_OLLAMA_URL=http://ollama:11434

# Extraction des formats anciens (facultatif)
URAG_TIKA_URL=http://tika:9998

# Sessions
URAG_ACCESS_TOKEN_TTL_MINUTES=15
URAG_REFRESH_TOKEN_TTL_HOURS=12

# Dossier des fichiers temporaires d'extraction
URAG_TMP_DIR=/var/lib/urag/tmp
